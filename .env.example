# Copy to .env on the VPS. Documentation values only; never commit the real file.
# The delegated zone. NS for it points at this host (see README).
DNSTEST_ZONE=dnstest.example.org
# The one site allowed to read results from the browser.
DNSTEST_ORIGIN=https://example.org
# Optional. The server finds this host's public IPv4 and IPv6 addresses itself.
# Set one only to override it, for example behind NAT with a different address.
# DNSTEST_IP4=203.0.113.10
# DNSTEST_IP6=2001:db8::10
# Optional. How often to fetch a new ASN table: a duration of at least 1m (default 1h), or "off".
# DNSTEST_ASN_UPDATE=off
